# SAIF AI Download Portal - Environment Configuration
#
# GATEWAY CONNECTION
# ------------------
# When SAIF_CLOUD_API_BASE_URL is set, the portal acts as a thin proxy to the
# real cloud gateway. All vault queries and downloads are forwarded there.
# When unset, the portal serves a self-contained demo vault for preview.
#
# Set this to your deployed cloud gateway URL, e.g.:
#   SAIF_CLOUD_API_BASE_URL=https://your-gateway-xyz.asia-southeast1.run.app
SAIF_CLOUD_API_BASE_URL=""

# GEMINI_API_KEY: Optional. Required only if using Gemini-powered features.
# AI Studio injects this automatically from user secrets at runtime.
GEMINI_API_KEY=""

# APP_URL: The public URL where this portal is hosted.
# Used for self-referential links (e.g. "copy share link" button).
# AI Studio injects this automatically with the Cloud Run service URL.
APP_URL=""

# GITHUB_PAT / GITHUB_TOKEN: Optional. Used by /api/trigger-build to
# dispatch GitHub Actions workflows in the SaifAI-Builder repository.
