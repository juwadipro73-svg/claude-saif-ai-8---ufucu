{
  "rules": {
    ".read": false,
    ".write": false,
    "apps": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        "$jobId": {
          ".validate": "newData.hasChildren(['kind','status','createdAt'])"
        }
      }
    },
    "cloudJobs": {
      ".read": false,
      ".write": false
    },
    "cloudLimits": {
      ".read": false,
      ".write": false
    }
  }
}
