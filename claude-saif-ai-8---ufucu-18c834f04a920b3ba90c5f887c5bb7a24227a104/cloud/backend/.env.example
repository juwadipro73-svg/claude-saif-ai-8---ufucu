# Template only. Configure real values through Cloud Run Secret Manager, never commit live secrets.
PORT=8080
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_ANDROID_APP_ID=1:1234567890:android:your-app-check-app-id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
STAGING_BUCKET=your-private-gcs-bucket
BUILDER_REPO=your-account/SaifAI-Builder
BUILDER_REF=main
# The separate SaifAI-Builder repository's actual workflow filename (PR #2 must be compatible and merged first).
BUILDER_WORKFLOW=build.yml
GITHUB_DISPATCH_TOKEN=github-fine-grained-token-for-workflow-dispatch
DRIVE_FOLDER_ID=private-folder-id
DOWNLOAD_SECRET=replace-with-32-plus-cryptographically-random-characters
WORKER_CALLBACK_SECRET=replace-with-another-32-plus-cryptographically-random-characters
# Personal Google Drive: use OAuth refresh token, same values in backend & builder Actions secrets.
# Backend also CREATES private APK/ZIP/video uploads: refresh token must have Drive write/file scope,
# not just drive.readonly. If omitted, use a Workspace Shared Drive + service account with
# read + drive.file access and explicit access to the configured private folder instead.
DRIVE_CLIENT_ID=oauth-client-id
DRIVE_CLIENT_SECRET=oauth-client-secret
DRIVE_REFRESH_TOKEN=oauth-refresh-token
